{
  "name": "codescene-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/codescene-oss/codescene-vscode.git"
  },
  "icon": "assets/cs-logo.png",
  "displayName": "CodeScene",
  "author": "CodeScene AB",
  "publisher": "CodeScene",
  "description": "Integrates CodeScene analysis into VS Code. Keeps your code clean and maintainable.",
  "version": "0.29.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeScene cannot work in untrusted environments because it depends on the Git extension, which cannot work in untrusted environments"
    }
  },
  "keywords": [
    "code analysis",
    "code health",
    "code review",
    "code quality",
    "code metrics",
    "cyclomatic complexity",
    "refactoring",
    "technical debt",
    "ai",
    "anthropic",
    "openai",
    "gemini",
    "gpt",
    "ai code review"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/main.js",
  "contributes": {
    "commands": [
      {
        "command": "codescene.createRulesTemplate",
        "title": "CodeScene: create Code Health Rules from template"
      },
      {
        "command": "codescene.checkRules",
        "title": "CodeScene: check Code Health Rules match for selected file",
        "when": "codescene.asyncActivationFinished"
      },
      {
        "command": "codescene.codeHealthMonitorHelp",
        "title": "CodeScene: Code Health Monitoring help",
        "icon": "$(question)"
      },
      {
        "command": "codescene.openCodeHealthDocs",
        "title": "CodeScene: open Code Health documentation"
      },
      {
        "command": "codescene.toggleReviewCodeLenses",
        "title": "CodeScene: toggle Review CodeLenses"
      },
      {
        "command": "codescene.stopAutomaticAnalysis",
        "title": "CodeScene: Stop Automatic Analysis"
      },
      {
        "command": "codescene.startAutomaticAnalysis",
        "title": "CodeScene: Start Automatic Analysis"
      },
      {
        "command": "codescene.showLogOutput",
        "title": "CodeScene: show output logs"
      },
      {
        "command": "codescene.copyDeviceId",
        "title": "CodeScene: copy Device ID"
      },
      {
        "command": "codescene.testConnectivity",
        "title": "CodeScene: test provider connectivity"
      },
      {
        "command": "codescene.browserSignIn",
        "title": "CodeScene: Sign in"
      },
      {
        "command": "codescene.browserSignOut",
        "title": "CodeScene: Sign out"
      },
      {
        "command": "codescene.openAccount",
        "title": "CodeScene: Open CodeScene account"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codescene-activity-bar",
          "title": "CodeScene",
          "icon": "$(cs-logo)"
        }
      ]
    },
    "views": {
      "codescene-activity-bar": [
        {
          "id": "codescene.statusView",
          "name": "Status",
          "type": "webview",
          "icon": "$(cs-logo)",
          "when": "false"
        },
        {
          "id": "codescene.backgroundService",
          "name": "",
          "icon": "$(cs-logo)",
          "when": "false"
        },
        {
          "id": "codescene.homeView",
          "name": "",
          "icon": "$(cs-logo)",
          "type": "webview",
          "when": "codescene.asyncActivationFinished"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "codescene.stopAutomaticAnalysis",
          "when": "config.codescene.enableAutomaticAnalysis"
        },
        {
          "command": "codescene.startAutomaticAnalysis",
          "when": "!config.codescene.enableAutomaticAnalysis"
        },
        {
          "command": "codescene.testConnectivity",
          "when": "codescene.aceUsable"
        },
        {
          "command": "codescene.browserSignIn",
          "when": "codescene.signInActive"
        },
        {
          "command": "codescene.browserSignOut",
          "when": "codescene.signInActive"
        },
        {
          "command": "codescene.openAccount",
          "when": "codescene.signInActive"
        }
      ]
    },
    "configuration": {
      "title": "CodeScene",
      "properties": {
        "codescene.enableReviewCodeLenses": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLenses for review diagnostics",
          "order": 1
        },
        "codescene.enableAutomaticAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze file changes in the workspace. Open editors are still reviewed for diagnostics and CodeLenses when this is off.",
          "order": 2
        },
        "codescene.enableAutoRefactor": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeScene Refactoring Agent",
          "order": 15
        },
        "codescene.agentModel": {
          "type": "string",
          "default": "amazon-bedrock/eu.anthropic.claude-sonnet-4-6",
          "enum": [
            "amazon-bedrock/eu.anthropic.claude-sonnet-4-6",
            "amazon-bedrock/eu.anthropic.claude-opus-5",
            "amazon-bedrock/eu.anthropic.claude-opus-4-8",
            "amazon-bedrock/eu.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "amazon-bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0",
            "amazon-bedrock/us.anthropic.claude-opus-5",
            "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
            "anthropic/claude-sonnet-4-0",
            "anthropic/claude-opus-4",
            "anthropic/claude-haiku-3-5-sonnet",
            "openai/gpt-4o",
            "openai/gpt-4-turbo",
            "openai/o3",
            "google/gemini-2.5-pro",
            "google/gemini-2.5-flash"
          ],
          "enumDescriptions": [
            "Claude Sonnet 4.6 via Amazon Bedrock (EU)",
            "Claude Opus 5 via Amazon Bedrock (EU) - Most advanced",
            "Claude Opus 4.8 via Amazon Bedrock (EU) - Optimized for coding",
            "Claude Sonnet 4.5 via Amazon Bedrock (EU) - Optimized for agents",
            "Claude Haiku 4.5 via Amazon Bedrock (EU) - Fast and lightweight",
            "Claude Opus 5 via Amazon Bedrock (US) - Most advanced",
            "Claude Sonnet 4.6 via Amazon Bedrock (US)",
            "Claude Sonnet 4.0 via Anthropic API",
            "Claude Opus 4 via Anthropic API",
            "Claude Haiku 3.5 via Anthropic API - Fast and lightweight",
            "GPT-4o via OpenAI API",
            "GPT-4 Turbo via OpenAI API",
            "o3 via OpenAI API - Advanced reasoning",
            "Gemini 2.5 Pro via Google API",
            "Gemini 2.5 Flash via Google API - Fast and efficient"
          ],
          "description": "Model to use for the Refactoring Agent.",
          "order": 16
        },
        "codescene.agentModelOverride": {
          "type": "string",
          "default": "",
          "description": "Custom model identifier. If set, overrides the dropdown selection above.",
          "order": 17
        },
        "codescene.providerOptions": {
          "type": "object",
          "properties": {
            "amazon-bedrock:profile": {
              "type": "string",
              "description": "AWS profile name for Amazon Bedrock"
            },
            "amazon-bedrock:region": {
              "type": "string",
              "description": "AWS region for Amazon Bedrock"
            },
            "anthropic:api-key": {
              "type": "string",
              "description": "API key for Anthropic"
            },
            "openai:api-key": {
              "type": "string",
              "description": "API key for OpenAI"
            },
            "google:api-key": {
              "type": "string",
              "description": "API key for Google (Gemini)"
            }
          },
          "additionalProperties": false,
          "default": {},
          "markdownDescription": "Provider-specific options for the Refactoring Agent. Use this to authenticate into your preferred model.\n\n**[Test connectivity](command:codescene.testConnectivity)**",
          "order": 18
        },
        "codescene.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "CodeScene server for browser sign-in, for example `https://codescene.example.com`. Leave empty to use `CS_ONPREM_URL`, then CodeScene Cloud. Used when `#codescene.experimental.signIn#` is on.",
          "order": 19.4
        },
        "codescene.authToken": {
          "type": "string",
          "default": "",
          "description": "Personal access token — an alternative to signing in, for WSL, remote and headless environments. Also used for refactoring. Browser sign-in is recommended.",
          "order": 19.5
        },
        "codescene.experimental.signIn": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Sign in to CodeScene in the browser (experimental). Requires a CodeScene IDE server with sign-in support.",
          "tags": [
            "experimental"
          ],
          "order": 19.6
        },
        "codescene.enableTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Enable sending usage telemetry to CodeScene",
          "order": 20
        },
        "codescene.serverWorkerThreads": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Number of worker threads used by the CodeScene IDE server. Set to 0 to use half of the available logical CPU cores.",
          "order": 21
        }
      }
    },
    "icons": {
      "cs-logo": {
        "description": "CodeScene logo",
        "default": {
          "fontPath": "assets/cs.woff",
          "fontCharacter": "\\e900"
        }
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "vscode:prepublish": "npm run package",
    "prepackage": "npm run updatecwf && npm run tsc && npm run lint && npm run clean",
    "package": "NODE_ENV=production node ./esbuild.js",
    "bundle-cli": "node ./scripts/bundle-cli.js",
    "package-platform": "node ./scripts/package-platform.js",
    "clean": "rm -rf ./out",
    "build": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "tsc": "tsc -p ./",
    "lint": "eslint src --max-warnings=0",
    "check-cwf": "node -e \"if (!require('fs').existsSync('cs-cwf/index.html')) { console.error('CWF files missing. Run: npm run updatecwf'); process.exit(1); }\"",
    "maybe-check-cwf": "node -e \"if (!process.env.CI && !require('fs').existsSync('cs-cwf/index.html')) { console.error('CWF files missing. Run: npm run updatecwf'); process.exit(1); }\"",
    "pretest": "npm run maybe-check-cwf && npm run tsc && npm run lint && npm run build && npm run bundle-cli-test",
    "bundle-cli-test": "node ./scripts/bundle-cli-for-current-platform.js",
    "test": "mocha",
    "benchmark": "mocha --config .mocharc.bench.json",
    "test:coverage": "c8 npm run test",
    "test:coverage:dual": "node ./scripts/test-coverage-dual.js",
    "updatecwf": "node scripts/update-cwf.js",
    "release:test": "node ./scripts/create-test-release.js"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/follow-redirects": "^1.14.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "22.19.21",
    "@types/pidusage": "^2.0.5",
    "@types/vscode": "1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^10.11.0",
    "extract-zip": "^2.0.1",
    "follow-redirects": "^1.16.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.2",
    "pidusage": "^4.0.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.throttle": "^4.1.9",
    "@types/vscode-webview": "^1.57.5",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.44",
    "axios": "^1.20.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "uuid": "^14.0.2",
    "vscode-jsonrpc": "^9.0.3"
  }
}
